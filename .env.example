# Defaults to a real local database at data/cecilia.sqlite.
# Set DATABASE_MODE=supabase after applying supabase/schema.sql to your project.
DATABASE_MODE=sqlite
DATABASE_PATH=data/cecilia.sqlite
PORT=3000
HOST=127.0.0.1

# Server-only. Never prefix a secret with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Preserved for future client authentication; this game currently uses only server APIs.
SUPABASE_PUBLISHABLE_KEY=
